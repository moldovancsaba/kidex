      "surface": "Chart rendering",
      "dependency": "recharts",
      "allowImports": [
        "recharts"
      ],
      "reason": "GDS governs chart framing, state handling, action placement, and mobile hierarchy, but the chart engine itself remains outside first-class GDS ownership.",
