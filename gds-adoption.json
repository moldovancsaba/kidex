      "reviewDate": "2026-05-28"
    },
    {
      "surface": "SearchableSelect adapter",
      "reason": "KIDEX still uses a reviewed thin adapter around Mantine Select for searchable/addable selection flows until GDS ships a canonical searchable-selection contract.",
